# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_SCOUT_CONTRACT_ID=

# ── Indexer ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scout
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_START_LEDGER=

# On-demand player profile revalidation webhook (issue #1672).
# The indexer POSTs HMAC-signed bodies to this URL after persisting player
# events (player_registered, profile_updated, milestone_approved,
# milestone_revoked, archive). Only the elected leader sends.
REVALIDATE_URL=http://localhost:3000/api/revalidate/player
# Shared secret used to HMAC-sign the webhook body. Must match on both sides.
REVALIDATE_SECRET=
# Minimum interval (ms) between webhook deliveries for the same player.
REVALIDATE_DEDUPE_WINDOW_MS=2000

# ── Cron / internal auth ─────────────────────────────────────────────────────
CRON_SECRET=
