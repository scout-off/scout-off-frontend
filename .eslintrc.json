{
  "extends": "next",
  "rules": {
    "react/jsx-no-target-blank": [
      "error",
      {
        "enforceDynamicLinks": "always"
      }
    ]
  },
  "overrides": [
    {
      "files": ["lib/**", "app/**", "hooks/**", "context/**", "components/**"],
      "excludedFiles": [
        "lib/logger.ts",
        "scripts/**",
        "**/__tests__/**",
        "**/*.stories.*"
      ],
      "rules": {
        "no-console": [
          "error",
          {
            "allow": ["warn", "error"]
          }
        ]
      }
    },
    {
      "files": ["app/**/*.tsx", "components/**/*.tsx"],
      "excludedFiles": [
        "app/api/**",
        "**/*.stories.tsx",
        "**/__tests__/**",
        "**/*.test.tsx"
      ],
      "rules": {
        "i18next/no-literal-string": [
          "warn",
          {
            "mode": "jsx-only",
            "jsx-attributes": {
              "include": ["placeholder", "aria-label", "title", "alt"]
            },
            "callees": {
              "exclude": [
                "i18n(ext)?",
                "t",
                "t[a-z]?",
                "t[a-z]?\\.rich",
                "require",
                "addEventListener",
                "removeEventListener",
                "postMessage",
                "getElementById",
                "dispatch",
                "commit",
                "includes",
                "indexOf",
                "endsWith",
                "startsWith"
              ]
            }
          }
        ]
      }
    }
  ],
  "plugins": ["i18next"]
}
